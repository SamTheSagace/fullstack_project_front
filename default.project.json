{
  "name": "fullstack_project",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Api": {
        "$path": "src/ReplicatedStorage/Api"
      },
      "Events": {
        "$path": "src/ReplicatedStorage/Events"
      },
      "Models": {
        "$path": "src/ReplicatedStorage/Models"
      },
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Types": {
        "$path": "src/ReplicatedStorage/Types"
      },
      "Packages": {
        "$path": "./Packages"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/ServerScriptService/Server"
      },
      "Services": {
        "$path": "src/ServerScriptService/Services"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/StarterPlayerScripts/Client"
        }
      }
    },
    "StarterGui": {
      "GUI": {
        "$path": "src/GUI"
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.38823, 0.37254, 0.38823],
          "Locked": true,
          "Position": [0, -10, 0],
          "Size": [512, 20, 512]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0, 0, 0],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
