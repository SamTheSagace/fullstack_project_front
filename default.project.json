{
  "name": "fullstack_project",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Api": {
        "$path": "src/ReplicatedStorage/Api"
      },
      "Packages": {
        "$path": ".wallyPackages/Packages"
      }
    },

    "ServerScriptService": {
      "$path": "src/ServerScriptService",
      "Server": {
        "$path": "src/ServerScriptService/Server"
      },
      "ServerPackages": {
        "$path": ".wallyPackages/ServerPackages"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayerScripts",
        "Client": {
          "$path": "src/StarterPlayerScripts/Client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}