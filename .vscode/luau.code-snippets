{
  "Require from ReplicatedStorage.Shared": {
    "scope": "lua,luau",
    "prefix": "reqsh",
    "body": [
      "local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")",
      "local Shared = ReplicatedStorage:WaitForChild(\"Shared\")",
      "local ${1:ModuleName} = require(Shared:WaitForChild(\"${1:ModuleName}\"))"
    ],
    "description": "Require a module from ReplicatedStorage/Shared"
  },

  "Require from ServerScriptService.Server": {
    "scope": "lua,luau",
    "prefix": "reqsv",
    "body": [
      "local ServerScriptService = game:GetService(\"ServerScriptService\")",
      "local Server = ServerScriptService:WaitForChild(\"Server\")",
      "local ${1:ModuleName} = require(Server:WaitForChild(\"${1:ModuleName}\"))"
    ],
    "description": "Require a module from ServerScriptService/Server"
  },

  "Require from StarterPlayerScripts.Client": {
    "scope": "lua,luau",
    "prefix": "reqcl",
    "body": [
      "local StarterPlayer = game:GetService(\"StarterPlayer\")",
      "local Client = StarterPlayer:WaitForChild(\"StarterPlayerScripts\"):WaitForChild(\"Client\")",
      "local ${1:ModuleName} = require(Client:WaitForChild(\"${1:ModuleName}\"))"
    ],
    "description": "Require a module from StarterPlayerScripts/Client"
  },

  "Load Shared Modules registry": {
    "scope": "lua,luau",
    "prefix": "modsh",
    "body": [
      "local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")",
      "local Modules = require(ReplicatedStorage:WaitForChild(\"Shared\"):WaitForChild(\"Modules\"))"
    ],
    "description": "Load shared Modules registry from ReplicatedStorage/Shared"
  }
}
